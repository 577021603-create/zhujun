# ==================== 邮件解析 ====================
def parse_mail_body(msg):
    body = ""
    try:
        if msg.is_multipart():
            for part in msg.walk():
                ct = part.get_content_type()
                if ct in ["text/plain", "text/html"]:
                    payload = part.get_payload(decode=True)
                    if payload:
                        cs = part.get_content_charset() or "utf-8"
                        txt = payload.decode(cs, errors='replace')
                        if ct == "text/html":
                            txt = html_to_string(txt)
                        body += txt + "\n"
        else:
            payload = msg.get_payload(decode=True)
            if payload:
                cs = msg.get_content_charset() or "utf-8"
                body = payload.decode(cs, errors='replace')
                if msg.get_content_type() == "text/html":
                    body = html_to_string(body)
    except Exception as e:
        logger.error(f"解析正文异常: {e}")
    return body.strip()


# ==================== 核心邮件处理 ====================
def process_emails():
    logger.info("\n======================================")
    logger.info(f"开始检查 - {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    mail = None

    try:
        now = datetime.now()
        start_time = now - timedelta(minutes=TIME_RANGE_MINUTES)
        imap_date = start_time.strftime("%d-%b-%Y")

        mail = imaplib.IMAP4_SSL(IMAP_SERVER, IMAP_PORT)
        mail.login(EMAIL, PASSWORD)
        logger.info("登录邮箱成功")

        all_recent = []

        for folder in CHECK_FOLDERS:
            try:
                stat, cnt = mail.select(folder, readonly=True)
                if stat != 'OK':
                    continue

                stat, ids_data = mail.search(None, f'SINCE "{imap_date}"')
                ids = ids_data[0].split()
                total = len(ids)
                logger.info(f"从 {folder} 搜索到符合日期邮件数: {total}")

                cnt_ok = 0

                for eid in ids:
                    try:
                        eid_str = eid.decode()
                        stat, dt_data = mail.fetch(eid, '(INTERNALDATE)')
                        if stat != 'OK':
                            continue

                        raw = dt_data[0].decode(errors='replace')
                        match = re.search(r'INTERNALDATE "([^"]+)"', raw)
                        if not match:
                            continue

                        internal_date = datetime.strptime(match.group(1), '%d-%b-%Y %H:%M:%S %z')
                        bj_time = internal_date.astimezone(timezone(timedelta(hours=8))).replace(tzinfo=None)

                        if bj_time >= start_time:
                            all_recent.append({
                                "id": eid_str,
                                "folder": folder,
                                "recv_time": internal_date
                            })
                            cnt_ok += 1
                    except:
                        continue

                logger.info(f"{folder} 符合近3分钟新邮件: {cnt_ok}")

            except Exception as e:
                logger.error(f"文件夹错误: {e}")
                continue

        new_mails = []
        for m in all_recent:
            try:
                mail.select(m["folder"], readonly=True)
                stat, data = mail.fetch(m["id"].encode(), "(RFC822)")
                msg = email.message_from_bytes(data[0][1])
                body = parse_mail_body(msg)

                if not is_email_processed(m["id"], body):
                    new_mails.append((m, msg, body))
            except Exception as e:
                continue

        logger.info(f"本次待处理新邮件: {len(new_mails)}")

        for idx, (m, msg, body) in enumerate(new_mails, 1):
            try:
                logger.info(f"\n--- 处理新邮件 {idx}/{len(new_mails)} ID:{m['id']} ---")
                subject = decode_str(msg.get('Subject', '无主题'))
                sender = decode_str(msg.get('From', ''))
                recv_time = m['recv_time'].astimezone(timezone(timedelta(hours=8))).strftime("%Y-%m-%d %H:%M:%S")

                logger.info(f"主题: {subject}")
                logger.info(f"发件人: {sender}")
                logger.info(f"接收时间: {recv_time}")
                preview = body[:500].replace('\n', ' ')
                logger.info(f"正文预览: {preview}")

                matches = check_keywords(body)
                if matches:
                    logger.warning(f"✅ 命中关键字: {matches}")
                    info = extract_info(body)
                    alarm_val = info["资源名称"] or info["告警主机"] or info["告警实例"] or subject
                    trigger_alarm(alarm_val)
                else:
                    logger.info("未匹配关键字")

                save_processed_email(m['id'], body)

            except Exception as e:
                logger.error(f"处理失败: {e}")
                continue

    except Exception as e:
        logger.error(f"主流程错误: {e}")
    finally:
        if mail:
            try:
                mail.logout()
            except:
                pass


