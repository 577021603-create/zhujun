def decode_str(s):
    try:
        parts = decode_header(s)
        res = []
        for p, enc in parts:
            if isinstance(p, bytes):
                res.append(p.decode(enc or 'utf-8', errors='replace'))
            else:
                res.append(str(p))
        return ''.join(res)
    except:
        return str(s)


def html_to_string(html):
    try:
        from bs4 import BeautifulSoup
        soup = BeautifulSoup(html, 'html.parser')
        for t in soup(["script", "style"]):
            t.decompose()
        return soup.get_text(separator=' ', strip=True)
    except:
        return html


def extract_info(text):
    d = {"资源名称": None, "告警主机": None, "告警实例": None}
    try:
        d["资源名称"] = re.search(r"资源名称[:：]\s*([^，,\n]+)", text).group(1).strip()
    except:
        pass
    try:
        d["告警主机"] = re.search(r"告警主机[:：]\s*([^，,\n]+)", text).group(1).strip()
    except:
        pass
    try:
        d["告警实例"] = re.search(r"告警实例[:：]\s*([^，,\n]+)", text).group(1).strip()
    except:
        pass
    return d


def check_keywords(text):
